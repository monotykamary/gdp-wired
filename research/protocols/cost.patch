+// Where a written invariant's time goes (research/protocols/COST.md): run.ts's given check (the search off) for one
+// protocol, with kernel/prove.ts's GDP_COST_LOG lines on stderr (each law's instances, each root goal's hypotheses,
+// rows, phases and CDCL counters, each model round) and every goal cut at a wall deadline so the run ends and reports.
+//   GDP_COST_LOG=1 bun research/protocols/cost.ts <id> [--deadline 300000] [--search 60000]
+import {proveRule} from '../../core/dsl.ts'
+import {profile, withDeadline} from '../../kernel/prove.ts'
+import {cdclStats} from '../../kernel/cdcl.ts'
+import {N, protocols} from './models.ts'
+import {forall} from '../../core/dsl.ts'
+
+const arg = (name: string) => { const i = process.argv.indexOf(`--${name}`); return i < 0 ? undefined : process.argv[i + 1] }
+const id = process.argv[2]!, deadline = Number(arg('deadline') ?? 300_000), search = arg('search')
+const p = protocols.find(q => q.id === id)!
+profile.on = true; cdclStats.on = true
+const r = p.make(), t0 = performance.now()
+// --extra: a conjunct the written invariant lacks, by protocol (COST.md says which and why)
+const extra = (r: any): any[] => !process.argv.includes('--extra') ? [] : id === 'distributed_lock'
+  ? [r.law('no transfer or lock before init', ({started, Transfer, Locked}: any) => forall((e, a) => a.lt(N).and(started.eq(0)).implies(Transfer.at(e.times(N).plus(a)).not().and(Locked.at(e.times(N).plus(a)).not()))))] : []
+const v: any = withDeadline(performance.now() + deadline, () => search ? proveRule(r, p.laws(r), {search: {ms: Number(search)}}) : proveRule(r, [...p.human(r), ...extra(r), ...p.laws(r)], {search: false}))
+const ms = Math.round(performance.now() - t0), grown = profile.goals.reduce((a, g) => a + g.ms, 0)
+console.log(JSON.stringify({id, mode: search ? `search ${search}` : 'given', verdict: v.proven && v.checked ? 'proven' : v.run ? 'refuted' : 'unknown', goal: v.goal, stuck: v.stuck, why: v.why && String(v.why).slice(0, 200),
+  ms, rootGoals: profile.goals.length, grownMs: Math.round(grown), cdcl: cdclStats}))
diff --git a/research/protocols/cost_prof.py b/research/protocols/cost_prof.py
new file mode 100644
index 0000000..3667f32
--- /dev/null
+++ b/research/protocols/cost_prof.py
@@ -0,0 +1,30 @@
+"""A .cpuprofile read for COST.md: self time by file and by function, and inclusive time for the functions given.
+    python3 cost_prof.py <profile> [fn,fn,...]"""
+import json, sys, collections
+d = json.load(open(sys.argv[1]))
+want = sys.argv[2].split(',') if len(sys.argv) > 2 else []
+nodes = {n['id']: n for n in d['nodes']}
+parent = {}
+for n in d['nodes']:
+    for c in n.get('children', []):
+        parent[c] = n['id']
+def short(u):
+    u = u.split('gdp-wired')[-1].lstrip('-cost').lstrip('/') if 'gdp-wired' in u else (u or '(native)')
+    return u
+def name(n):
+    cf = n['callFrame']; return f"{cf['functionName'] or '(anon)'} {short(cf['url'])}:{cf['lineNumber'] + 1}"
+self_t = collections.Counter(); file_t = collections.Counter(); incl = collections.Counter(); total = 0.0
+for sid, dt in zip(d['samples'], d['timeDeltas']):
+    dt = max(dt, 0) / 1000.0; total += dt
+    n = nodes[sid]; self_t[name(n)] += dt; file_t[short(n['callFrame']['url'])] += dt
+    seen = set(); i = sid
+    while i is not None:
+        cf = nodes[i]['callFrame']; fn = f"{cf['functionName']}@{short(cf['url']).split('/')[-1]}"
+        if cf['functionName'] and fn not in seen: seen.add(fn); incl[fn] += dt
+        i = parent.get(i)
+print(f"profile total {total/1000:.1f} s")
+print("self by file:", ", ".join(f"{f} {t/total*100:.1f}%" for f, t in file_t.most_common(14)))
+print("self by function:")
+for f, t in self_t.most_common(30): print(f"  {t/total*100:5.1f}%  {t/1000:7.1f} s  {f}")
+print("inclusive:", ", ".join(f"{f} {incl[f]/total*100:.1f}%" for f in want))
+print("inclusive top:", ", ".join(f"{f} {t/total*100:.1f}%" for f, t in incl.most_common(60)))
