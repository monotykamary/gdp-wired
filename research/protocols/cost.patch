+"""GDP_COST_LOG's lines (kernel/prove.ts, research only) summed for COST.md: where a run's time went.
+    python3 cost_sum.py <stderr log> [top]"""
+import json, sys, collections
+top = int(sys.argv[2]) if len(sys.argv) > 2 else 15
+ev = collections.defaultdict(list)
+for line in open(sys.argv[1], errors='replace'):
+    if line.startswith('[cost] '):
+        try: o = json.loads(line[7:]); ev[o['ev']].append(o)
+        except Exception: pass
+    elif line.startswith('{"id"'): print('verdict:', line.strip()[:600])
+goals = ev['goal']; gms = sum(g['ms'] for g in goals)
+ph = collections.Counter(); cd = collections.Counter()
+for g in goals:
+    ph.update(g['phases']); cd.update(g['cdcl'])
+print(f"root goals {len(goals)}, grown {gms/1000:.1f} s; instance building {sum(o['ms'] for o in ev['inst'])/1000:.1f} s; thinning {sum(o['ms'] for o in ev['thin'])/1000:.1f} s; "
+      f"model rounds {len(ev['round'])} (their instance reads {sum(o['miMs'] for o in ev['round'])/1000:.1f} s); check {sum(o['ms'] for o in ev['check'])/1000:.1f} s")
+print("phases (s):", {k: round(v/1000, 1) for k, v in ph.most_common()})
+inner = sum(cd[k] for k in ('rowsMs', 'orderMs', 'boundMs', 'solveMs', 'coreMs', 'unfoldMs'))
+print("cdcl (s): rows/sync", round(cd['rowsMs']/1000, 1), "candidates/relevance", round(cd['orderMs']/1000, 1), "bound prop", round(cd['boundMs']/1000, 1),
+      "simplex", round(cd['lpMs']/1000, 1), "elimination", round((cd['solveMs'] - cd['lpMs'])/1000, 1), "core", round(cd['coreMs']/1000, 1), "unfold", round(cd['unfoldMs']/1000, 1),
+      "rest (unit propagation, analysis)", round((ph['cdcl'] - inner)/1000, 1), "| nodes", cd['nodes'], "conflicts", cd['conflicts'], "decisions", cd['decisions'], "pivots", cd['pivots'])
+outs = collections.Counter((g['out'], (g.get('why') or '')[:40]) for g in goals)
+print("outcomes:", dict(outs.most_common(8)))
+by = collections.defaultdict(lambda: {'n': 0, 'ms': 0, 'hyps': 0, 'rows': 0, 'outs': collections.Counter()})
+for g in goals:
+    b = by[g['goal']]; b['n'] += 1; b['ms'] += g['ms']; b['hyps'] = max(b['hyps'], g['hyps']); b['rows'] = max(b['rows'], g['rows']); b['outs'][g['out'] + ('/' + g['why'][:12] if g.get('why') else '')] += 1
+print(f"top goals by time (of {len(by)} names):")
+for name, b in sorted(by.items(), key=lambda x: -x[1]['ms'])[:top]:
+    print(f"  {b['ms']/1000:7.1f} s  x{b['n']:<3} hyps<={b['hyps']:<5} rows<={b['rows']:<5} {dict(b['outs'])}  {name[:90]}")
+print("slowest single goals (ms, hyps, chars, rows, phases, cdcl nodes, out):")
+for g in sorted(goals, key=lambda g: -g['ms'])[:top]:
+    print(f"  {g['ms']:7}  {g['hyps']:5} {g['chars']:9} {g['rows']:5} {g['phases']} n={g['cdcl']['nodes']} {g['out']}{('/' + g['why'][:50]) if g.get('why') else ''}  {g['goal'][:70]}")
+laws = collections.defaultdict(list)
+for o in ev['law']: laws[o['law']].append(o)
+print("laws (attempt ms, outcome; largest instance counts):")
+for o in ev['inst']:
+    tries = laws.get(o['law'], [])
+    big = sorted(((v, k) for k, v in (tries[-1]['counts'] if tries else o['counts']).items()), reverse=True)[:4]
+    print(f"  {o['keys']} keys, built {o['ms']} ms, tries {[(t['which'], t['ms'], t['out'][-28:]) for t in tries]}  big: {[(k[:28], v) for v, k in big]}  {o['law'][:60]}")
+if '--all' in sys.argv:
+    print("every root goal (ms, hyps, rows, out, goal):")
+    for g in goals: print(f"G\t{g['ms']}\t{g['hyps']}\t{g['rows']}\t{g['out']}{('/' + g['why'][:30]) if g.get('why') else ''}\t{g['goal'][:80]}")
