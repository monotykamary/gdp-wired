    "+// Untrusted, bounded reuse of small completed source subtrees. Alpha matching",
    "+// only proposes a renaming. renameProof maps every used row and emits the full",
    "+// ordinary tree; the destination still goes through the unchanged kernel.",
    "+import type {C} from '../machine.ts'",
    "+import {env} from '../solver.ts'",
    "+import {type Goal,type Path,type Tree} from '../../kernel/kernel.ts'",
    "+import {clock,usedHyps} from '../../kernel/prove.ts'",
    "+import {proverHypotheses} from '../../kernel/prover-rows.ts'",
    "+import {renameProof} from './rename-proof.ts'",
    "+const shapes=new WeakMap<C,string|false>()",
    "+function shape(c:C):string|false{",
    "+ const old=shapes.get(c);if(old!==undefined)return old",
    "+ let left=128",
    "+ const walk=(v:unknown):unknown=>{",
    "+  if(--left<0)throw new Error('shape cap')",
    "+  if(!v||typeof v!=='object')return v",
    "+  if(Array.isArray(v))return v.map(walk)",
    "+  const o=v as Record<string,unknown>",
    "+  if(o.op==='var')return ['var']",
    "+  return Object.keys(o).sort().map(k=>[k,walk(o[k])])",
    "+ }",
    "+ let out:string|false=false;try{out=JSON.stringify(walk(c))}catch{/* not a cache candidate */}",
    "+ shapes.set(c,out);return out",
    "+}",
    "+function match(a:unknown,b:unknown,names:Record<string,string>):boolean{",
    "+ if(!a||!b||typeof a!=='object'||typeof b!=='object')return a===b",
    "+ if(Array.isArray(a)||Array.isArray(b))return Array.isArray(a)&&Array.isArray(b)&&a.length===b.length&&a.every((v,i)=>match(v,b[i],names))",
    "+ const x=a as Record<string,unknown>,y=b as Record<string,unknown>",
    "+ if(x.op==='var'&&y.op==='var'){",
    "+  const from=String(x.name),to=String(y.name)",
    "+  if(Object.hasOwn(names,from))return names[from]===to",
    "+  if(Object.values(names).includes(to))return false",
    "+  names[from]=to;return true",
    "+ }",
    "+ const keys=Object.keys(x);return keys.length===Object.keys(y).length&&keys.every(k=>Object.hasOwn(y,k)&&match(x[k],y[k],names))",
    "+}",
    "+type Entry={goal:Goal,path:Path,tree:Tree,requires:C[],anchor:C,key:string,owner?:object}",
    "+export const sharedSourceStats={stored:0,attempts:0,hits:0,rejected:0}",
    "+export class SharedSourceProofs{",
    "+ private entries:Entry[]=[]",
    "+ private index=new Map<string,Entry[]>()",
    "+ private seen=new WeakSet<Tree>()",
    "+ constructor(private enabled=()=>env.GDP_SOURCE_SHARED!=='0'){}",
    "+ put(goal:Goal,path:Path,tree:Tree,owner?:object):void{",
    "+  if(!this.enabled()||this.seen.has(tree))return",
    "+  const stack=[tree];let nodes=0",
    "+  while(stack.length){const t=stack.pop()!;if(++nodes>64)return;if(!('leaf'in t))stack.push(t.yes,t.no)}",
    "+  const hyps=proverHypotheses(goal),requires=[...usedHyps(goal,tree,path)].map(i=>hyps[i]!).filter(Boolean)",
    "+  const anchors=requires.flatMap(c=>{const key=shape(c);return key?[{c,key}]:[]}).sort((a,b)=>b.key.length-a.key.length),first=anchors[0]",
    "+  if(!first)return",
    "+  const entry={goal,path:new Map(path),tree,requires,anchor:first.c,key:first.key,owner}",
    "+  if(this.entries.length>=64){const old=this.entries.shift()!;const bucket=this.index.get(old.key)!.filter(e=>e!==old);if(bucket.length)this.index.set(old.key,bucket);else this.index.delete(old.key)}",
    "+  this.entries.push(entry);this.index.set(entry.key,[...this.index.get(entry.key)??[],entry]);this.seen.add(tree);sharedSourceStats.stored++",
    "+ }",
    "+ get(goal:Goal,path:Path,until:number,owner?:object):Tree|undefined{",
    "+  if(!this.enabled()||!this.entries.length||clock()>=until||owner&&this.entries.every(e=>e.owner===owner))return undefined",
    "+  const hyps=proverHypotheses(goal),available=new Set(hyps),byShape=new Map<string,C[]>()",
    "+  for(const c of hyps){const key=shape(c);if(key)byShape.set(key,[...byShape.get(key)??[],c])}",
    "+  const end=Math.min(until,clock()+10);let tried=0,considered=0",
    "+  for(const [key,targets]of byShape)for(const entry of this.index.get(key)??[])for(const target of targets.slice(0,4)){",
    "+   if(owner&&entry.owner===owner)continue",
    "+   if(clock()>=end||tried>=2||considered++>=8)return undefined",
    "+   let names:Record<string,string>=Object.create(null)",
    "+   if(!match(entry.anchor,target,names))continue",
    "+   let supported=true",
    "+   for(const c of entry.requires){",
    "+    if(c===entry.anchor)continue",
    "+    const k=shape(c),possibles=available.has(c)?[c]:k?byShape.get(k)??[]:[]",
    "+    let found=false",
    "+    for(const other of possibles.slice(0,4)){const next={...names};if(match(c,other,next)){names=next;found=true;break}}",
    "+    if(!found){supported=false;break}",
    "+   }",
    "+   if(!supported)continue",
    "+   tried++;sharedSourceStats.attempts++",
    "+   const out=renameProof(entry.goal,entry.tree,entry.path,path,names,end,goal)",
    "+   if(out){sharedSourceStats.hits++;return out}",
    "+   sharedSourceStats.rejected++",
    "+  }",
    "+  return undefined",
    "+ }",
    "+}",
    "+export const sharedSourceProofs=new SharedSourceProofs()",
