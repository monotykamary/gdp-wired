(format LCTRS)
(theory Ints)
(fun l0 (-> Int Int))
(fun l1 (-> Int Int))
(fun l2 (-> Int Int))
(fun l3 (-> Int Int))
(fun l4 (-> Int Int))
(fun l5 (-> Int Int))
(fun lend (-> Int Int))
(entrypoint l0)
(rule (l0 dummy) (l1 dummy))
(rule (l1 dummy) (l2 dummy))
(rule (l2 dummy) (l3 dummy) :guard (< 1 0))
(rule (l2 dummy) (l4 dummy))
(rule (l3 dummy) (l2 dummy))
(rule (l4 dummy) (lend dummy))
(rule (l5 dummy) (lend dummy))
