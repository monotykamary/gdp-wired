[{"name":"follow-up-diagnostics","cpu":1,"memory":2048,"timeout":60,"cmd":"bun -e 'import{readFileSync}from\"node:fs\";const log=readFileSync(\"source-check/follow-up-source-check.log\",\"utf8\");for(const line of log.split(\"\\n\")){if(line.startsWith(\"FOLLOW_TOOLS_CHECK \")){const r=JSON.parse(line.slice(\"FOLLOW_TOOLS_CHECK \".length));console.log(\"SOURCE_CHECK_DIAG \"+JSON.stringify({exit:r.exit,signal:r.signal,wallMs:r.wallMs,classification:r.resources?.classification,oomDelta:r.resources?.oomDelta,stdout:r.stdout,stderr:r.stderr}));}else if(!line.startsWith(\"FOLLOW_SOURCE_INPUT \")&&!line.startsWith(\"BAR_RESOURCE_\"))console.log(line)}console.log(\"COMMITLINT_DIAG\\n\"+readFileSync(\"epyc/follow-up-commitlint.log\",\"utf8\"));'"}]
