import {resolve} from 'node:path'
const root=resolve(process.argv[2]!),on=process.argv[3]==='on'
const {canon,canonFlip}=await import(resolve(root,'kernel/kernel.ts'))
const {canon:solverCanon}=await import(resolve(root,'core/solver.ts'))
const {rawWork,workKeys}=await import(resolve(root,'core/work-meter.ts'))
const {setNativeSpanBuffer,readNativeSpan}=await import(resolve(root,'research/lane-i/f3/native-spans.ts'))
const shared=new Int32Array(new SharedArrayBuffer(36));if(on)setNativeSpanBuffer(shared)
const inputs:Record<string,number>[]=[]
for(const size of [0,1,2,16,256]){
 const lin:Record<string,number>=Object.create(null)
 for(let i=0;i<size;i++)lin[i%3===0?String(i):'key-'+i]=(i%7)-3
 inputs.push(lin)
}
for(const value of [0,-0,1,-1,0.5,NaN,Infinity,-Infinity])inputs.push({1:value,x:2})
const special:Record<string,number>=Object.create(null);Reflect.set(special,'__proto__',3);Reflect.set(special,'constructor',4);Reflect.set(special,'toString',-2);inputs.push(special)
const calls:string[]=[]
const getter:Record<string,number>={};Object.defineProperty(getter,'g',{enumerable:true,get:()=>{calls.push('get');return 2}});inputs.push(getter)
const broken:Record<string,number>={};Object.defineProperty(broken,'throw',{enumerable:true,get:()=>{calls.push('throw');throw Error('same failure')}});inputs.push(broken)
const before=rawWork(),results=[]
for(const lin of inputs)for(const fn of [canon,canonFlip,solverCanon])for(let repetition=0;repetition<2;repetition++){
 try{results.push({ok:true,value:fn(lin)})}catch(error){results.push({ok:false,error:String(error)})}
}
const {walkOnce}=await import(resolve(root,'core/machine.ts'))
const {certFor}=await import(resolve(root,'core/counts.ts'))
const leaf={tag:'leaf'},graph:any={tag:'root',children:[leaf,leaf]};graph.self=graph
const visited:string[]=[];walkOnce(graph,(o:any)=>visited.push(Array.isArray(o)?'array':o.tag));results.push({walk:visited})
const decls=[{map:'Rows',below:{op:'const',value:3},j:'j',key:'key',body:{op:'var',name:'key'}}]
const goal={hyps:[{op:'<=',a:{op:'get',map:'Rows',key:{op:'var',name:'x'}},b:{op:'const',value:2}}]}
for(const wide of [false,true])for(const most of [0,5,24])results.push({wide,most,certificate:certFor(goal,decls,wide,most,()=>true)})
const after=rawWork(),raw=Object.fromEntries(workKeys.map((key:string)=>[key,after[key]-before[key]]))
console.log('NATIVE_CANON_PROBE '+JSON.stringify({on,results,calls,raw,span:readNativeSpan(shared)}))
