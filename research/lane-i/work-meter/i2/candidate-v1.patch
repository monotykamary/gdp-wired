diff --git a/core/meter.test.ts b/core/meter.test.ts
new file mode 100644
index 00000000..575bf868
--- /dev/null
+++ b/core/meter.test.ts
@@ -0,0 +1,60 @@
+import {beforeEach, expect, test} from 'bun:test'
+import {type C, type E, type Machine, type State, compileC, compileE, compileJs, evalC, evalE, fastStep, interpret} from './machine.ts'
+import {coreMeter} from './meter.ts'
+
+const m: Machine = {name: 'evaluation meter', params: [], inputs: [], state: {}, step: {}}
+const st: State = {scalars: {}, maps: {A: new Map([[0, 7]])}}
+const n = (value: number): E => ({op: 'const', value})
+const measure = <T>(run: () => T) => { const start = coreMeter.evals; return {value: run(), nodes: coreMeter.evals - start} }
+beforeEach(() => { Object.assign(coreMeter, {astNodes: 0, evals: 0, cubeTests: 0, ticks: 0}) })
+
+test('interpreter and closures charge visited expression nodes, not compilation or untaken branches', () => {
+  const e: E = {op: 'if', c: {op: '<=', a: n(1), b: n(2)}, then: {op: 'add', a: n(3), b: n(4)}, else: {op: 'var', name: 'missing'}}
+  const run = compileE(e, m)
+  expect(coreMeter.evals).toBe(0)
+  expect(measure(() => evalE(e, {}, st, m))).toEqual({value: 7, nodes: 7})
+  expect(measure(() => run({}, st))).toEqual({value: 7, nodes: 7})
+})
+
+test('short-circuiting conditions charge only the visited children', () => {
+  const c: C = {op: 'and', xs: [{op: '=', a: n(1), b: n(2)}, {op: '=', a: {op: 'var', name: 'missing'}, b: n(0)}]}
+  expect(measure(() => evalC(c, {}, st, m))).toEqual({value: false, nodes: 4})
+  const run = compileC(c, m)
+  expect(measure(() => run({}, st))).toEqual({value: false, nodes: 4})
+})
+
+test('failed evaluation is charged before it throws', () => {
+  const e: E = {op: 'var', name: 'missing'}, run = compileE(e, m)
+  expect(() => evalE(e, {}, st, m)).toThrow('no value for missing')
+  expect(coreMeter.evals).toBe(1)
+  expect(() => run({}, st)).toThrow('no value for missing')
+  expect(coreMeter.evals).toBe(2)
+})
+
+test('compiled map reads and quantified fallback are not charged twice', () => {
+  const e: E = {op: 'get', map: 'A', key: n(0)}
+  expect(measure(() => evalE(e, {}, st, m))).toEqual({value: 7, nodes: 2})
+  const get = compileE(e, m)
+  expect(measure(() => get({}, st))).toEqual({value: 7, nodes: 2})
+  const c: C = {op: 'all', key: 'i', c: {op: '=', a: {op: 'var', name: 'i'}, b: {op: 'var', name: 'i'}}}, run = compileC(c, m)
+  const interpreted = measure(() => evalC(c, {}, st, m))
+  expect(interpreted.nodes).toBeGreaterThan(1)
+  expect(measure(() => run({}, st))).toEqual(interpreted)
+})
+
+test('a compiled step uses its fixed static expression count without changing public generated source', () => {
+  const machine: Machine = {name: 'compiled meter', params: [], inputs: [], state: {z: n(0)}, step: {state: {z: {op: 'add', a: {op: 'var', name: 'z'}, b: n(1)}}}}
+  const run = interpret(machine), start = run.init({}), fast = fastStep(machine)!
+  expect(compileJs(machine)).not.toContain('coreMeter')
+  const result = measure(() => fast({}, start, {}))
+  expect(result.nodes).toBe(3)
+  expect(result.value.scalars.z).toBe(1)
+  expect(start.scalars.z).toBe(0)
+})
+
+test('a refused compiled step still receives its static charge', () => {
+  const machine: Machine = {name: 'refused compiled meter', params: [], inputs: ['take'], state: {}, assume: {op: '<', a: {op: 'var', name: 'take'}, b: n(1)}, step: {state: {z: n(2)}}}
+  const run = fastStep(machine)!, before = coreMeter.evals
+  expect(() => run({}, {scalars: {}, maps: {}}, {take: 2})).toThrow("fails the rule's assumption")
+  expect(coreMeter.evals - before).toBe(4)
+})
