+// Raw observations only: trusted checkers increment, but never branch on these.
+// No budget, reset, weight, timer, callback or acceptance decision belongs here.
+// Counter scope and calibrated aggregation belong to the untrusted prover.
+export const kernelMeter = {
+  tableCells: 0,
+  checkSteps: 0,
+  astNodes: 0,
+  evals: 0,
+  cubeTests: 0,
+  ticks: 0,
+}
+
+// Evaluate every child first; charge the newly allocated node, never its reused subtree.
+export function observeAst<T>(node: T): T {
+  kernelMeter.astNodes += 1
+  return node
+}
