+import {rule, proveRule} from './dsl.ts'
+import {costs} from './solver.ts'
+import {clock, fullRate, fullWork, pastWall, wallAt, withWall} from '../kernel/prove.ts'
+import {budgetEnd, checkWall, inBudget, searchNow, searchWall, transportEnd, withBudget} from './wall.ts'
+
+test('work-mode compatibility stops never consult wall time or add transport headroom', () => {
+  const before = {...costs}, mock = spyOn(performance, 'now').mockImplementation(() => { throw Error('raw wall read') })
+  try {
+    withBudget(1000, () => {
+      const end = budgetEnd(), start = clock()
+      expect(searchNow()).toBe(start)
+      expect(wallAt()).toBe(end)
+      expect(searchWall(10000)).toBe(end)
+      expect(searchWall(1)).toBe(start + 1)
+      expect(transportEnd(start + 1)).toBe(start + 1)
+      withWall(end, () => { costs.fm++; checkWall('counted transport'); expect(pastWall()).toBe(false) })
+      expect(clock() - start).toBeCloseTo(2.33 / fullRate)
+    })
+    expect(inBudget()).toBe(false)
+  } finally { mock.mockRestore(); Object.assign(costs, before) }
+})
+
+test('a checked counted-rule search survives a throwing wall clock', () => {
+  const r = rule('counted clock regression').state({value: 0})
+    .counts({Rows: () => ({below: 2, body: () => 1})})
+    .step(({Rows}) => ({value: Rows.at(0)}))
+  const law = r.law('bounded', ({value}) => value.atMost(2))
+  const mock = spyOn(performance, 'now').mockImplementation(() => { throw Error('count search read wall time') })
+  try {
+    const initial = fullWork(), result = proveRule(r, [law], {search: {work: 2500000}})
+    expect(result.proven && result.checked).toBe(true)
+    expect(fullWork()).toBeGreaterThan(initial)
+    expect(inBudget()).toBe(false)
+  } finally { mock.mockRestore() }
+})
