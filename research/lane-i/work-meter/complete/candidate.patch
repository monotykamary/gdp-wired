+})
+
+test('every candidate tick is observed without changing its local cap or terminal state', () => {
+  const budget = candidateWork(), before = coreMeter.ticks
+  expect(budget.state.limit).toBe(65_536)
+  budget.state.limit = 2
+  expect([budget.tick(), budget.tick(), budget.tick(), budget.tick()]).toEqual([true, true, false, false])
+  expect(budget.state.work).toBe(2)
+  expect(budget.state.exhausted).toBe(true)
+  expect(coreMeter.ticks - before).toBe(4)
+})
+
+test('watch observations match the pre-existing private tuple counter', () => {
+  const run = interpret(m), law = {name: 'watch truth', holds: {op: '=' as const, a: n(1), b: n(1)}}
+  const observer = watch(m, run, law, {}, 2), before = {raw: coreMeter.ticks, private: watchWork.n}
