+import {beforeEach, expect, test} from 'bun:test'
+import {type C, type E, type Machine, fnCall, n, plus, same, x} from './machine.ts'
+import {coreMeter, observeAst} from './meter.ts'
+import {kernelMeter} from '../kernel/meter.ts'
+import {obligations, substC, substE} from '../kernel/kernel.ts'
+import {finiteHoudini} from './finite-houdini.ts'
+import {recur, rule} from './dsl.ts'
+
+beforeEach(() => { for (const key of Object.keys(coreMeter) as (keyof typeof coreMeter)[]) coreMeter[key] = 0 })
+
+test('core and trusted checkers share one raw object; allocation observation preserves identity', () => {
+  expect(coreMeter).toBe(kernelMeter)
+  const node = {op: 'const' as const, value: 7}
+  expect(observeAst(node)).toBe(node)
+  expect(coreMeter.astNodes).toBe(1)
+})
+
+test('substitution charges only new nodes, never an unchanged leaf or shared replacement', () => {
+  const leaf: E = {op: 'var', name: 'x'}, replacement: E = {op: 'const', value: 3}
+  const s = {vars: {x: replacement}, maps: {}, flags: {}}
+  expect(substE(leaf, s)).toBe(replacement)
+  expect(substE(replacement, s)).toBe(replacement)
+  expect(coreMeter.astNodes).toBe(0)
+  const input: C = {op: '=', a: {op: 'add', a: leaf, b: replacement}, b: replacement}
+  expect(substC(input, s)).toEqual({op: '=', a: {op: 'add', a: replacement, b: replacement}, b: replacement})
+  expect(coreMeter.astNodes).toBe(2)
+})
+
+test('public expression factories count each newly allocated node once', () => {
+  const before = coreMeter.astNodes
+  expect(plus(n(1), n(2))).toEqual({op: 'add', a: {op: 'const', value: 1}, b: {op: 'const', value: 2}})
+  expect(coreMeter.astNodes - before).toBe(3)
+})
+
+test('obligations and a refused finite-prefix tick cannot be invisible', () => {
+  const m: Machine = {name: 'meter complete', params: [], inputs: [], state: {value: n(0)}, step: {state: {value: plus(x('value'), n(1))}}}
+  const law = {name: 'zero', holds: same(x('value'), n(0))}
+  const before = coreMeter.astNodes
+  expect(obligations(m, [law]).length).toBeGreaterThan(0)
+  expect(coreMeter.astNodes).toBeGreaterThan(before)
+  const ticks = coreMeter.ticks
+  expect(finiteHoudini(m, m, [], [law], [{p: {}, sts: [{scalars: {value: 0}, maps: {}}]}], {workLimit: 1, targeted: false, randomStates: 0, requests: 1})).toEqual([law])
+  expect(coreMeter.ticks - ticks).toBeGreaterThan(0)
+})
+
+test('direct recurrence execution is observed but a reused cached result is not reevaluated', () => {
+  const r = rule('counted recurrence').state({value: 0}).fns({steps: recur('observedSteps', {zero: 0, next: (_, prev) => prev.plus(1)})})
+  const f = r.machine.fns!.steps!
+  const before = coreMeter.evals
+  expect(fnCall(f, [3])).toBe(3)
+  expect(coreMeter.evals - before).toBeGreaterThan(0)
+  const cached = coreMeter.evals
+  expect(fnCall(f, [3])).toBe(3)
+  expect(coreMeter.evals).toBe(cached)
+})
