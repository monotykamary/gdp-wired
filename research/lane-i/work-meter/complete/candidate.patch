+++ b/kernel/work-budget.test.ts
@@ -0,0 +1,65 @@
+import {expect, spyOn, test} from 'bun:test'
+import {costs} from '../core/solver.ts'
+import {traceNow} from '../core/trace-clock.ts'
+import {BudgetExpired, budgetEnd, checkBudget, clock, counted, fullRate, fullWork, inBudget, late, withBudget, withWork} from './prove.ts'
+
+function counters<T>(f: () => T): T {
+  const before = {...costs}
+  try { return f() } finally { Object.assign(costs, before) }
+}
+
+test('explicit work scopes use the full counter without reading wall time', () => counters(() => {
+  const mock = spyOn(performance, 'now').mockImplementation(() => { throw Error('search read wall time') })
+  try {
+    expect(withBudget(10, () => {
+      expect(inBudget()).toBe(true)
+      expect(budgetEnd() - clock()).toBeCloseTo(10 / fullRate)
+      costs.fm++
+      checkBudget('one operation')
+      expect(Number.isFinite(traceNow())).toBe(true)
+      return 'done'
+    })).toBe('done')
+    expect(inBudget()).toBe(false)
+    expect(budgetEnd()).toBe(Infinity)
+  } finally { mock.mockRestore() }
+}))
+
+test('nested work scopes cannot replenish or enlarge their parent', () => counters(() => {
+  withBudget(10, () => {
+    const end = budgetEnd()
+    costs.fm++
+    withBudget(1000, () => expect(budgetEnd()).toBe(end))
+    const spent = fullWork()
+    expect(() => withBudget(2, () => { costs.fm++; checkBudget('nested') })).toThrow(BudgetExpired)
+    expect(fullWork()).toBeGreaterThan(spent)
+    expect(budgetEnd()).toBe(end)
+    checkBudget('outer remains usable')
+  })
+}))
+
+test('final work and an inherited work cap cannot escape the scope', () => counters(() => {
+  expect(() => withBudget(1, () => { costs.fm++; return 'unchecked completion' })).toThrow(BudgetExpired)
+  expect(inBudget()).toBe(false)
+  withWork(fullWork() + 1, () => expect(() => withBudget(1000, () => { costs.fm++ })).toThrow(BudgetExpired))
+  expect(inBudget()).toBe(false)
+}))
+
+test('work scope state is restored after errors and nested counted islands keep its clock', () => counters(() => {
+  const failure = new Error('callback failed')
+  expect(() => withBudget(100, () => { throw failure })).toThrow(failure)
+  expect(inBudget()).toBe(false)
+  withBudget(100, () => {
+    const start = clock()
+    counted(1, () => { costs.fm++; expect(clock() - start).toBeCloseTo(2.33 / fullRate) })
+    expect(late(budgetEnd())).toBe(false)
+  })
+  counted(1, () => expect(() => withBudget(1, () => 0)).toThrow('outer full-work clock'))
+}))
+
+test('zero and invalid work allowances never create extra fuel', () => counters(() => {
+  expect(withBudget(0, () => 'no counted work')).toBe('no counted work')
+  expect(() => withBudget(0, () => { costs.fm++ })).toThrow(BudgetExpired)
+  for (const units of [-1, NaN, Infinity]) expect(() => withBudget(units, () => 0)).toThrow(RangeError)
+  expect(inBudget()).toBe(false)
+  expect(() => checkBudget('outside a work scope')).not.toThrow()
+}))
