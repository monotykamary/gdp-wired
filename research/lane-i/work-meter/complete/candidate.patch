@@ -0,0 +1,34 @@
+import {expect, test} from 'bun:test'
+import {rule, proveRule} from './dsl.ts'
+import {inBudget} from './wall.ts'
+
+const countedRule = () => rule('explicit work count').state({value: 0})
+  .counts({Rows: () => ({below: 2, body: () => 1})})
+  .step(({Rows}) => ({value: Rows.at(0)}))
+
+test('explicit work mode cannot mint fuel or leak its scope', () => {
+  const r = countedRule(), law = r.law('bounded', ({value}) => value.atMost(2))
+  const empty = proveRule(r, [law], {search: {work: 0}})
+  expect(empty.proven).toBe(false)
+  expect(inBudget()).toBe(false)
+  expect(() => proveRule(r, [law], {search: {work: -1}})).toThrow(RangeError)
+  expect(() => proveRule(r, [law], {search: {work: 1, ms: 1}})).toThrow(RangeError)
+})
+
+test('a fitting counted proof and a false caller keep their checked verdicts', () => {
+  const r = countedRule(), law = r.law('bounded', ({value}) => value.atMost(2))
+  const good = proveRule(r, [law], {search: {work: 2500000}})
+  expect(good.proven && good.checked).toBe(true)
+  const bad = r.step(({Rows}) => ({value: Rows.at(0).plus(1)}))
+  expect(proveRule(bad, [law], {search: {work: 2500000}}).proven).toBe(false)
+  expect(inBudget()).toBe(false)
+})
+
+test('the plain-path migration remains explicitly separate from count work mode', () => {
+  const r = rule('plain work pending').state({value: 0}).step(({value}) => ({value}))
+  const law = r.law('zero', ({value}) => value.eq(0))
+  const result = proveRule(r, [law], {search: {work: 100000}})
+  expect(result.proven).toBe(false)
+  expect(result.why).toBe('work mode: plain-path migration pending')
+  expect(proveRule(r, [law], {search: {ms: 1000}}).proven).toBe(true)
+})
