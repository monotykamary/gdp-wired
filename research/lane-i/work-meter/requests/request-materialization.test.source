import {test, expect} from 'bun:test'
import {strict as assert} from 'node:assert'
import {readFileSync} from 'node:fs'
import {coreMeter} from './meter.ts'

type Domains = [string, unknown[]][]
type Product = (domains: Domains, meter: {tableCells: number}, limit: number, random: (n: number) => number) => Record<string, unknown>[]
const baselineStatement = __BASELINE_STATEMENT__
const lines = readFileSync(new URL('./infer.ts', import.meta.url), 'utf8').split('\n')
const matches = lines.map((line, index) => ({line, index})).filter(({line}) => line.includes('for (const [i, d] of doms) combos = combos.flatMap'))
assert.equal(matches.length, 1, 'test the actual production expression, not a copied instrumented helper')
const {line, index} = matches[0]!
assert(line.includes('coreMeter.tableCells += Object.keys(c).length + 1'))
const truncate = lines[index + 1]!.trim()
assert(truncate.startsWith('if (combos.length > combosMax) combos = Array.from('))
const build = async (expression: string): Promise<Product> => {
  // The adjacent production statement contains TypeScript non-null assertions.
  // Compile it with Bun rather than editing the source expression for JavaScript.
  const body = 'export const execute = (doms, coreMeter, combosMax, rnd) => { let combos = [{}];\n' + expression + '\n' + truncate + '\nreturn combos }'
  const js = new Bun.Transpiler({loader: 'ts'}).transformSync(body)
  // Load an isolated module instead of bypassing the no-implied-eval rule.
  const loaded = await import('data:text/javascript;base64,' + Buffer.from(js).toString('base64')) as {execute: Product}
  return loaded.execute
}
const product = await build(line), original = await build(baselineStatement)
function measured(domains: Domains, limit = 100000, random: (n: number) => number = () => 0) {
  const before = coreMeter.tableCells
  const rows = product(domains, coreMeter, limit, random)
  return {rows, cells: coreMeter.tableCells - before}
}

test('request construction observes every copied field and new assignment, in original order', () => {
  const domains: Domains = [['a', [1, 2]], ['b', [3, 4, 5]]]
  const {rows, cells} = measured(domains)
  expect(rows).toEqual([{a: 1, b: 3}, {a: 1, b: 4}, {a: 1, b: 5}, {a: 2, b: 3}, {a: 2, b: 4}, {a: 2, b: 5}])
  expect(cells).toBe(2 + 6 * 2)
  expect(domains).toEqual([['a', [1, 2]], ['b', [3, 4, 5]]])
})
test('overwritten request keys still observe the copied field and assignment', () => {
  const {rows, cells} = measured([['x', [1, 2]], ['x', [3, 4]]])
  expect(rows).toEqual([{x: 3}, {x: 4}, {x: 3}, {x: 4}])
  expect(cells).toBe(2 + 4 * 2)
})
test('zero emitted records cause no fabricated materialization count', () => {
  expect(measured([['a', []], ['b', [1, 2]]])).toEqual({rows: [], cells: 0})
  expect(measured([])).toEqual({rows: [{}], cells: 0})
})
test('map-valued inputs retain their original identity', () => {
  const value = new Map([[0, 1]]), {rows, cells} = measured([['m', [value]], ['n', [4]]])
  expect(rows[0]!.m).toBe(value)
  expect(cells).toBe(3)
  expect([...value]).toEqual([[0, 1]])
})
test('truncation follows full materialization and keeps its RNG call sequence', () => {
  const domains: Domains = [['a', Array.from({length: 64}, (_, i) => i)], ['b', Array.from({length: 64}, (_, i) => i)]]
  const observed: number[] = [], baseline: number[] = []
  const actual = measured(domains, 8, n => { observed.push(n); return n - 1 })
  const expected = original(domains, {tableCells: 0}, 8, n => { baseline.push(n); return n - 1 })
  expect(actual.rows).toEqual(expected)
  expect(actual.rows).toHaveLength(8)
  expect(actual.cells).toBe(64 + 4096 * 2)
  expect(observed).toEqual(baseline)
  expect(observed).toEqual(Array(8).fill(4096))
})
test('seeded domain cases retain baseline outputs, inputs and RNG calls', () => {
  let seed = 1481
  const random = (n: number) => { seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0; return seed % n }
  for (let trial = 0; trial < 128; trial++) {
    const domains: Domains = Array.from({length: random(6)}, () => ['k' + random(4), Array.from({length: random(4)}, () => random(13))])
    const saved = JSON.stringify(domains), limit = 1 + random(17), start = seed
    const observed: number[] = [], baseline: number[] = []
    const actual = measured(domains, limit, n => { observed.push(n); return random(n) })
    seed = start
    const expected = original(domains, {tableCells: 0}, limit, n => { baseline.push(n); return random(n) })
    expect(actual.rows).toEqual(expected)
    expect(observed).toEqual(baseline)
    expect(JSON.stringify(domains)).toBe(saved)
    expect(Number.isSafeInteger(actual.cells) && actual.cells >= 0).toBe(true)
  }
})
