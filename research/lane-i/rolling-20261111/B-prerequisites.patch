+ expect(replayScopedCountProof(f.m,[{...f.left,holds:same(x('left'),n(1))},f.right],scoped,until)).toBeUndefined()
+ expect(replayScopedCountProof(f.m,structuredClone([f.left,f.right]),scoped,until)).toBeDefined()
