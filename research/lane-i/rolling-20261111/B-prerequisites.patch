+          if (part.op !== '=') return
+          const [v, key] = part.a.op === 'var' && part.a.name === write.each ? [part.a, part.b] : [part.b, part.a]
+          if (v.op === 'var' && v.name === write.each && key.op === 'var' && m.inputs.includes(key.name)) rows.add(key.name)
+        })
