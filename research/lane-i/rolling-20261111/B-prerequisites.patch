@@ -0,0 +1,33 @@
+import {expect, spyOn, test} from 'bun:test'
+import {admitCountedFamily} from './counts.ts'
+import {type Law, type Machine, all, any, atMost, get, n, same, x} from './machine.ts'
+import {checkCountedLaws} from '../kernel/kernel.ts'
+import {clock, counted, fullRate, withWall} from '../kernel/prove.ts'
+
+const machine = (broken = false): Machine => ({name: 'counted supported family', params: [], inputs: ['action'], inputMaps: ['Input'], state: {value: n(0)},
+  counts: {Rows: {j: 'row', key: 'member', below: n(2), body: n(1)}},
+  assume: all(any(...[0, 1, 2].map(i => same(x('action'), n(i))))), step: {state: {value: broken ? n(3) : get('Rows', n(0))}}})
+const bounded: Law = {name: 'bounded', holds: atMost(x('value'), n(2))}
+function admission(jump: number, broken = false, allowance = 3000) {
+  let wall = 1_000_000
+  const mock = spyOn(performance, 'now').mockImplementation(() => (wall += jump))
+  try {
+    return withWall(Infinity, () => counted(fullRate, () => {
+      const m = machine(broken), result = admitCountedFamily(m, [bounded], [bounded], new Set([bounded]), clock() + allowance)
+      return {proven: result.proven, laws: result.laws.map(l => l.name), checked: !!result.proof && checkCountedLaws(m, result.laws, result.proof)}
+    }, true))
+  } finally { mock.mockRestore() }
+}
+
+test('supported admission is unchanged by a slow or jumping telemetry clock', () => {
+  const expected = {proven: true, laws: ['bounded'], checked: true}
+  for (const jump of [0, 10_000, 1_000_000]) expect(admission(jump)).toEqual(expected)
+})
+
+test('clock independence cannot admit a false caller', () => {
+  for (const jump of [0, 10_000, 1_000_000]) expect(admission(jump, true)).toEqual({proven: false, laws: ['bounded'], checked: false})
+})
+
+test('supported admission cannot revive an exhausted counted allowance', () => {
+  for (const jump of [0, 10_000]) expect(admission(jump, false, 0)).toEqual({proven: false, laws: ['bounded'], checked: false})
+})
diff --git a/core/count-write-shape.ts b/core/count-write-shape.ts
new file mode 100644
index 000000000..38a876e20
--- /dev/null
+++ b/core/count-write-shape.ts
@@ -0,0 +1,56 @@
+// Untrusted structural discovery for a threshold write at its source row.
+// No operation, field, law, or protocol name is built in.
+import {type C, type E, type Machine, walkOnce} from './machine.ts'
+import {type CountGuardShape} from './count-guard-shape.ts'
+const atoms = (c: C): C[] => c.op === 'and' ? c.xs.flatMap(atoms) : [c]
+export type CountThresholdWrite = {source: string, guard: string, increment: 0 | 1, input: string, inputCount: string, committedInput?: string, committedCount?: string}
+const fields = (value: unknown): Set<string> => {const out = new Set<string>(); walkOnce(value, (node: any) => {if (node.op === 'get') out.add(node.map)}); return out}
+export function discoverCountThresholdWrite(m: Machine, shape: CountGuardShape, choice: {name: string, value: number}): CountThresholdWrite | undefined {
+  const write = m.step.maps?.[shape.thresholdField]
+  if (!write || !('each' in write)) return
+  const inputCount = (input: string) => Object.entries(m.counts ?? {}).filter(([, count]) => {
+    const maps = fields(count.body)
+    return !count.base && count.body.op === 'if' && count.body.then.op === 'const' && count.body.then.value === 1 && count.body.else.op === 'const' && count.body.else.value === 0 && maps.size === 1 && maps.has(input)
+  }).map(([name]) => name)
+  const candidates: CountThresholdWrite[] = []
+  walkOnce(write.value, (node: any) => {
+    if (node.op !== 'if') return
+    let value: E = node.then, increment: 0 | 1 = 0
+    if (value.op === 'add') {
+      const [a, b] = value.a.op === 'const' ? [value.b, value.a] : [value.a, value.b]
+      if (b.op !== 'const' || b.value !== 1) return
+      value = a; increment = 1
+    }
+    if (value.op !== 'get' || value.map !== shape.memberField || value.key.op !== 'var' || !m.inputs.includes(value.key.name)) return
+    const source = value.key.name, gate = atoms(node.c)
+    if (!gate.some(c => c.op === '=' && ((c.a.op === 'var' && c.a.name === write.each && c.b.op === 'var' && c.b.name === source) || (c.b.op === 'var' && c.b.name === write.each && c.a.op === 'var' && c.a.name === source)))) return
+    for (const c of gate) {
+      if (c.op !== 'flag') continue
+      const active = m.step.flags?.[c.name]
+      if (!active || active.op === 'all' || !atoms(active).some(a => {
+        if (a.op !== '=') return false
+        const [v, n] = a.a.op === 'var' ? [a.a, a.b] : [a.b, a.a]
+        return v.op === 'var' && v.name === choice.name && n.op === 'const' && n.value === choice.value
+      })) continue
+      const direct = [...fields(active)].filter(map => m.inputMaps?.includes(map))
+      if (direct.length !== 1) continue
+      const input = direct[0]!, ownCounts = inputCount(input)
+      if (ownCounts.length !== 1) continue
+      const all = new Set(fields(active)), seen = new Set<string>()
+      const expand = (value: C): void => walkOnce(value, (node: any) => {
+        if (node.op !== 'flag' || seen.has(node.name)) return
+        seen.add(node.name)
+        const flag = m.step.flags?.[node.name]
+        if (flag) {for (const field of fields(flag)) all.add(field); expand(flag)}
+      })
+      expand(active)
+      const other = [...all].filter(map => map !== input && m.inputMaps?.includes(map))
+      if (other.length > 1) continue
+      const committedInput = other[0], committed = committedInput ? inputCount(committedInput) : []
+      if (committedInput && committed.length !== 1) continue
+      candidates.push({source, guard: c.name, increment, input, inputCount: ownCounts[0]!, ...(committedInput ? {committedInput, committedCount: committed[0]!} : {})})
+    }
+  })
+  const unique = [...new Map(candidates.map(value => [JSON.stringify(value), value])).values()]
+  return unique.length === 1 ? unique[0] : undefined
+}
diff --git a/core/field-loaded.test.ts b/core/field-loaded.test.ts
new file mode 100644
index 000000000..d3201db49
--- /dev/null
+++ b/core/field-loaded.test.ts
@@ -0,0 +1,107 @@
+import {expect, test} from 'bun:test'
+import {type C, type E, type Machine, all, any, atMost, get, interpret, less, n, not, same, times, plus, x} from './machine.ts'
+import {fieldLaws, selectFieldLaws, weakensField} from './field-laws.ts'
+import {scope} from '../kernel/kernel.ts'
+
+function fixture(prefix = '', stride = 8): Machine {
+  const i = prefix + 'i', j = prefix + 'j', size = prefix + 'size', z = prefix + 'cell'
+  const rows = prefix + 'Rows', source = prefix + 'Source', marker = prefix + 'Marker', f = prefix + 'Version', g = prefix + 'Term'
+  const phase = prefix + 'phase', ready = prefix + 'ready', flag = prefix + 'load'
+  const lo = times(stride, x(i)), window = all(atMost(lo, x(z)), less(x(z), plus(lo, n(stride))))
+  const column: E = {op: 'sub', a: x(z), b: lo}
+  return {name: prefix + 'loaded rows', params: [size], inputs: [i, j], state: {[phase]: n(0), [ready]: n(1)},
+    maps: {[rows]: 0, [source]: 0, [marker]: 0, [f]: 0, [g]: 0}, assume: less(x(i), x(size)),
+    step: {flags: {[flag]: all(same(x(phase), n(0)), same(x(ready), n(1))),
+      fields: same(get(f, x(i)), get(g, x(i))), read: same(get(rows, plus(times(stride, x(i)), x(j))), n(1))},
+      maps: {[rows]: {each: z, value: {op: 'if', c: all({op: 'flag', name: flag}, window), then: get(source, column), else: get(rows, x(z))}},
+        [marker]: {key: x(i), value: {op: 'if', c: {op: 'flag', name: flag}, then: n(1), else: get(marker, x(i))}}}}}
+}
+const loadLaws = (m: Machine) => fieldLaws(m).filter(law => law.name.includes(' row is '))
+const rowWrite = (m: Machine) => {
+  const write = m.step.maps!.Rows!
+  if (!('each' in write) || write.value.op !== 'if') throw Error('fixture row shape')
+  return write.value
+}
+const markerWrite = (m: Machine) => {
+  const write = m.step.maps!.Marker!
+  if ('each' in write || write.value.op !== 'if') throw Error('fixture marker shape')
+  return write.value
+}
+
+test('loaded row families are structural under renaming and multiple strides', () => {
+  for (const prefix of ['', 'other_']) for (const stride of [4, 8]) {
+    const m = fixture(prefix, stride), laws = fieldLaws(m), loads = loadLaws(m)
+    expect(loads).toHaveLength(3)
+    expect(laws.filter(law => law.name.includes('and ' + prefix + 'Marker[a]=' + prefix + 'Marker[b]=1'))).toHaveLength(1)
+    expect(new Set(laws.map(law => JSON.stringify(law.holds))).size).toBe(laws.length)
+    expect(() => scope(m, laws)).not.toThrow()
+    expect(fieldLaws(m)).toEqual(laws)
+  }
+})
+
+test('a minimal admitted singleton suppresses later load guards, not prior families', () => {
+  const m = fixture(), laws = fieldLaws(m), loads = laws.filter(law => law.name.includes(' row is ')), whole = loads[0]!, first = loads[1]!, second = loads[2]!
+  expect(weakensField.get(first)).toBe(whole)
+  expect(weakensField.get(second)).toBe(whole)
+  expect(selectFieldLaws(laws, law => loads.includes(law))).toEqual([whole])
+  const visited: string[] = []
+  expect(selectFieldLaws(laws, law => { visited.push(law.name); return law === first || law === second })).toEqual([first])
+  expect(visited).not.toContain(second.name)
+  expect(selectFieldLaws(laws, law => law === second)).toEqual([second])
+  const prior = laws.filter(law => !law.name.includes(' row is ') && !law.name.includes('and Marker[a]=Marker[b]'))
+  expect(selectFieldLaws(prior, () => true)).toEqual(prior)
+})
+
+test('compiled Boolean marker muxes retain the direct load shape', () => {
+  const direct = fixture(), compiled = fixture(), flag: C = {op: 'flag', name: 'load'}
+  const marker = markerWrite(compiled)
+  marker.c = any(all(flag, atMost(n(0), n(0))), all(not(flag), same(get('Marker', x('i')), n(1))))
+  marker.then = n(1); marker.else = n(0)
+  expect(loadLaws(compiled)).toEqual(loadLaws(direct))
+  const a = interpret(direct), b = interpret(compiled)
+  for (const phase of [0, 1]) for (const ready of [0, 1]) for (const old of [0, 1]) {
+    const state = {scalars: {phase, ready}, maps: {Rows: new Map(), Source: new Map(), Marker: new Map([[0, old]]), Version: new Map(), Term: new Map()}}
+    expect(a.step({size: 1}, state, {i: 0, j: 0}).maps.Marker?.get(0) ?? 0).toBe(b.step({size: 1}, state, {i: 0, j: 0}).maps.Marker?.get(0) ?? 0)
+  }
+})
+
+test('negated or merely disjunctive marker flags do not establish a load marker', () => {
+  for (const condition of [not({op: 'flag', name: 'load'}), any({op: 'flag', name: 'load'}, same(x('ready'), n(0)))]) {
+    const m = fixture(); markerWrite(m).c = condition
+    expect(loadLaws(m)).toEqual([])
+  }
+})
+
+test('the load read must share a positive flag and both exact row-window bounds', () => {
+  const flag: C = {op: 'flag', name: 'load'}, lo = times(8, x('i')), z = x('cell')
+  const invalid: C[] = [flag, all(flag, atMost(lo, z)), all(flag, less(z, plus(lo, n(8)))),
+    all(flag, atMost(lo, z), less(z, plus(lo, n(4)))),
+    all(not(flag), atMost(lo, z), less(z, plus(lo, n(8))))]
+  for (const condition of invalid) {
+    const m = fixture(); rowWrite(m).c = condition
+    expect(loadLaws(m)).toEqual([])
+  }
+  const m = fixture(), value = rowWrite(m), previous = value.then
+  value.then = value.else; value.else = previous
+  expect(loadLaws(m)).toEqual([])
+})
+
+test('mismatched marker keys and source strides are not guessed', () => {
+  const keyed = fixture(), marker = keyed.step.maps!.Marker!
+  if ('each' in marker) throw Error('fixture marker shape')
+  marker.key = x('j')
+  expect(loadLaws(keyed)).toEqual([])
+  const shifted = fixture()
+  rowWrite(shifted).then = get('Source', {op: 'sub', a: x('cell'), b: times(4, x('i'))})
+  expect(loadLaws(shifted)).toEqual([])
+})
+
+test('nested conjunctions expose singleton guards without capturing binder names', () => {
+  const m = fixture()
+  m.state['a$field'] = n(0); m.inputs.push('b$field')
+  m.step.flags!.load = {op: 'and', xs: [{op: 'and', xs: [same(x('phase'), n(0))]}, same(x('ready'), n(1))]}
+  const laws = loadLaws(m)
+  expect(laws).toHaveLength(3)
+  expect(laws[0]!.forall).not.toBe('a$field')
+  expect(() => scope(m, laws)).not.toThrow()
+})
diff --git a/core/finite-work.test.ts b/core/finite-work.test.ts
