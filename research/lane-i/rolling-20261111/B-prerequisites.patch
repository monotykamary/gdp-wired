+    const read = (map: string, key: E) => reads.find(r => r[1] === map && JSON.stringify(r[2]) === JSON.stringify(key))?.[0]
+    const postVote = read(shape.voteMap + '#', key(a, b)), postRow = read(shape.rowMap + '#', a), bound = counts.find(c => c.v === postVote)?.below
