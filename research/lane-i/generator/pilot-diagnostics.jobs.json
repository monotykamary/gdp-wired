[
  {
    "name": "census-pilot-diagnostics",
    "cmd": "bun -e 'import{readFileSync}from\"node:fs\";import{gunzipSync}from\"node:zlib\";const text=readFileSync(\"pilot/generator-census-consensus-pilot.log\",\"utf8\");for(const line of text.split(\"\\n\")){if(!line.startsWith(\"GENERATOR_CHECK \"))continue;const r=JSON.parse(line.slice(16));console.log(\"PILOT_CHECK_DIAG \"+JSON.stringify({label:r.label,exit:r.exit,signal:r.signal,wallMs:r.wallMs,trace:gunzipSync(Buffer.from(r.traceGzipBase64,\"base64\")).toString().slice(-14000),resources:r.exit===0?undefined:gunzipSync(Buffer.from(r.resourcesGzipBase64,\"base64\")).toString().slice(-8000)}))}'",
    "cpu": 1,
    "memory": 2048,
    "timeout": 60
  }
]
