+++ b/core/count-cert-transport.test.ts
@@ -0,0 +1,34 @@
+import {expect,test} from 'bun:test'
+import {atMost,less,n,x} from './machine.ts'
+import {type CountCert,type Goal,type LemmaCut,type Path,type Tree,canon,checkGoalLemmas,leafConstraintsReusing,lemmaPath} from '../kernel/kernel.ts'
+import {refuteFast} from './solver.ts'
+import {countedCertificateHyps,transportCountCertificate} from './count-cert-transport.ts'
+
+const prove=(goal:Goal,path:Path):Tree=>{
+ const result=refuteFast(leafConstraintsReusing(goal,path),256)
+ if(result?.kind!=='refuted')throw new Error('expected fixture refutation')
+ return {leaf:result.steps}
+}
+function fixture(){
+ const goal:Goal={name:'certificate support',hyps:[atMost(x('y'),x('x')),atMost(x('x'),n(0)),less(n(0),x('y'))]},cut={y:1}
+ const source={...goal,hyps:goal.hyps.slice(0,2)},path:Path=new Map([[canon(cut),{lin:cut,holds:false}]])
+ const lemma:LemmaCut={when:[],cut,slice:[0,1],tree:prove(source,path)},lemmas=[lemma]
+ const cert:CountCert={reads:[],insts:[],lemmas,tree:prove(goal,lemmaPath(lemmas,new Map()))}
+ return {goal,cert}
+}
+test('counted support includes independent lemma source slices',()=>{
+ const {goal,cert}=fixture()
+ expect(checkGoalLemmas(goal,cert.tree,cert.lemmas)).toBe(true)
+ expect([...countedCertificateHyps(goal,cert)!].sort((a,b)=>a-b)).toEqual([0,1,2])
+})
+test('complete counted certificates retain cuts across reordered and enlarged contexts',()=>{
+ const {goal,cert}=fixture(),target={...goal,hyps:[atMost(n(0),n(1)),goal.hyps[2]!,goal.hyps[1]!,goal.hyps[0]!]}
+ const next=transportCountCertificate(goal,target,cert,performance.now()+2000)
+ expect(next).toBeDefined()
+ if(next){expect(next.lemmas?.length).toBe(1);expect(checkGoalLemmas(target,next.tree,next.lemmas)).toBe(true)}
+ expect(transportCountCertificate(goal,{...goal,hyps:goal.hyps.slice(1)},cert,performance.now()+2000)).toBeUndefined()
+})
+test('counted certificate transport does not extend expired deadlines',()=>{
+ const {goal,cert}=fixture()
+ expect(transportCountCertificate(goal,goal,cert,performance.now()-1)).toBeUndefined()
+})
diff --git a/core/count-cert-transport.ts b/core/count-cert-transport.ts
new file mode 100644
index 00000000..899efbab
--- /dev/null
+++ b/core/count-cert-transport.ts
@@ -0,0 +1,38 @@
+// Untrusted integration helpers for complete counted certificates. The kernel
+// still checks the emitted ordinary tree and independent conditional cuts.
+import {type CountCert,type Goal,type Path,canon,lemmaPath} from '../kernel/kernel.ts'
+import {usedHyps,widen} from '../kernel/prove.ts'
+import {collectConditionalCertificate,markConditionalProof,transportConditionalProof} from './count-recovery/conditional-proof.ts'
+
+export function transportCountCertificate(from:Goal,to:Goal,cert:CountCert,until:number):CountCert|undefined{
+ if(performance.now()>=until)return undefined
+ if(!cert.lemmas?.length){const tree=widen(from,to,cert.tree);return tree&&performance.now()<until?{...cert,tree}:undefined}
+ const marked=markConditionalProof(from,cert.tree,cert.lemmas),tree=transportConditionalProof(from,to,marked,new Map(),new Map(),until)
+ const combined=tree&&collectConditionalCertificate(to,tree,until)
+ return combined?{...cert,...combined}:undefined
+}
+
+export function countedCertificateHyps(goal:Goal,cert:CountCert):Set<number>|undefined{
+ if(!cert.lemmas?.length)return usedHyps(goal,cert.tree)
+ try{
+  const found=new Set<number>(),seen=new WeakSet<object>()
+  const visit=(tree:CountCert['tree'],path:Path):boolean=>{
+   if(seen.has(tree))return false
+   seen.add(tree)
+   if('split'in tree){
+    const id=canon(tree.split),yes=new Map(path).set(id,{lin:tree.split,holds:true}),no=new Map(path).set(id,{lin:tree.split,holds:false})
+    const valid=visit(tree.yes,yes)&&visit(tree.no,no);seen.delete(tree);return valid
+   }
+   for(const i of usedHyps(goal,tree,lemmaPath(cert.lemmas!,path)))found.add(i)
+   seen.delete(tree);return true
+  }
+  if(!visit(cert.tree,new Map()))return undefined
+  // Every listed cut is checked, even when the main tree does not cite it.
+  // Its explicit source slice must survive dependency pruning as a whole.
+  for(const lemma of cert.lemmas){
+   if(lemma.slice===undefined){for(let i=0;i<goal.hyps.length;i++)found.add(i);continue}
+   for(const i of lemma.slice){if(!Number.isSafeInteger(i)||i<0||i>=goal.hyps.length)return undefined;found.add(i)}
+  }
+  return found
+ }catch{return undefined}
+}
